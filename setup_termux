# Problème 2/20: tester SSH dès que les clés existent, pas après attente utilisateur
log "Test rapide de authentification SSH..."
# `ssh -T` vers GitHub sort TOUJOURS en code 1 (même si authentifié) : avec
# `pipefail`, `ssh ... | grep -q` ne peut donc jamais réussir. On neutralise
# le code de ssh et on laisse grep décider seul.
_ssh_test_ok() {
  local out
  out="$(ssh -T -o StrictHostKeyChecking=no -o BatchMode=yes -o ConnectTimeout=5 "git@$1" 2>&1 || true)"
  grep -q "successfully authenticated" <<<"${out}"
}
if _ssh_test_ok "${GITHUB_HOST_ALIAS}"; then
  log "SSH '${GITHUB_HOST_ALIAS}' déjà authentifié ✓"
else
  log "SSH '${GITHUB_HOST_ALIAS}' pas encore testé — vérification interactive plus bas."
fi
if _ssh_test_ok "${GITHUB_MAIN_ALIAS}"; then
  log "SSH '${GITHUB_MAIN_ALIAS}' déjà authentifié ✓"
else
  log "SSH '${GITHUB_MAIN_ALIAS}' pas encore testé — vérification interactive plus bas."
fi

echo "Attends d'avoir ajouté LES DEUX clés sur GitHub, puis appuie sur Entrée..."
read -r

# Vérification itérative des clés SSH — boucle tant que les 2 clés ne sont pas validées
# (même remarque pipefail que _ssh_test_ok ci-dessus : le code de ssh est neutralisé)
_check_ssh() {
  local alias="$1"
  echo "  -> ssh -T -o StrictHostKeyChecking=accept-new -o BatchMode=yes git@$alias"
  local out
  out="$(ssh -T -o StrictHostKeyChecking=accept-new -o BatchMode=yes git@$alias 2>&1 || true)"
  grep -q "successfully authenticated" <<<"${out}"
}

# Boucle de vérification : affiche les clés à chaque échec et réessaie
MAX_ATTEMPTS=30
attempt=0
while true; do
  setup_ok=false
  story_ok=false

  _check_ssh "${GITHUB_HOST_ALIAS}" && setup_ok=true
  _check_ssh "${GITHUB_MAIN_ALIAS}" && story_ok=true

  if ${setup_ok} && ${story_ok}; then
    log "SSH authentifié ✓ (${GITHUB_HOST_ALIAS} + ${GITHUB_MAIN_ALIAS})"
    break
  fi

  attempt=$((attempt + 1))
  if [ "${attempt}" -ge "${MAX_ATTEMPTS}" ]; then
    echo "ERREUR: impossible d'authentifier les clés après ${MAX_ATTEMPTS} essais." >&2
    echo "Vérifie que les clés publiques sont bien ajoutées sur les deux repos GitHub." >&2
    exit 1
  fi

  echo ""
  echo "⚠ Clés non encore authentifiées (essai ${attempt}/${MAX_ATTEMPTS})..."
  # NOTE: `[ false ]` est toujours vrai (chaîne non vide) — tester la valeur explicitement
  if ${setup_ok}; then setup_mark='✓'; else setup_mark='✗'; fi
  if ${story_ok}; then story_mark='✓'; else story_mark='✗'; fi
  echo "  ${GITHUB_HOST_ALIAS} : ${setup_mark}"
  echo "  ${GITHUB_MAIN_ALIAS} : ${story_mark}"
  echo ""
  _display_keys
  echo "Attends d'avoir ajouté les clés sur GitHub, puis appuie sur Entrée pour réessayer..."
  # Pause incompressible : en run non-interactif les `read` sont consommés aussitôt —
  # sans ça les 30 essais s'épuisent en quelques minutes (délai d'activation GitHub)
  sleep 20
  read -r
done

