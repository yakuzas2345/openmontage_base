    || git remote add "${STORY_REMOTE}" "git@${GITHUB_MAIN_ALIAS}:${GITHUB_STORY_REPO}"
  git pull --ff-only || log "pull a échoué (ignore — branche locale divergente ?)"
  # Reprise : se replacer sur la branche de setup (convention `_`), pas sur un résidu
  if [ "$(git symbolic-ref --short HEAD 2>/dev/null)" != "${BOOTSTRAP_BRANCH}" ]; then
