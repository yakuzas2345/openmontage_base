#!/data/data/com.termux/files/usr/bin/env bash
#
# setup_termux — Bootstrap complet : Termux → PRoot Ubuntu LTS → opencode
#                + OpenMontage (utilisateur sudo + dossiers de stockage).
#
# À télécharger et lancer tel quel :  bash setup_termux
# Optionnel (forcer la version Ubuntu) :  bash setup_termux ubuntu:24.04
#
# Aucune distinction d'utilisateur : le nom du nouvel utilisateur est détecté
# automatiquement (utilisateur Termux courant, sinon "user" par défaut).
#
# La grosse étape (installation opencode + OpenMontage dans le PRoot) est une
# adaptation du script setup_ubuntu.sh du repo openmontage_base, embarquée
# ci-dessous. ASSUME_YES=1 répond Oui automatiquement à ses invites.
#
# Corrections apportées (autopsie 29 erreurs) :
#   - Test connectivité réseau avant toute opération (problèmes 27-29)
#   - Nettoyage git index.lock avant ops git (problème 16)
#   - Configuration git user.name/email globale (problème 18)
#   - Ajout chemin corepack npm au PATH (problème 8)
#   - Ajout /usr/local/bin au PATH conteneur (problème 13)
#   - Symlink ~/.opencode/bin/opencode → /usr/local/bin (problème 11)
#   - Branch naming : _ au lieu de -, suffixe numeric si conflit (problème 15)
#   - Remote story nom conforme à la branche (problème 17)
#   - Dépendances Python supplémentaires : pillow, numpy, imageio (problème 24)
#   - Alias .bashrc corrigés pour les deux environnements (problèmes 12-13)
#   - Test SSH dès génération des clés (problèmes 2/20)

set -e

# --- Helpers ---
step() { echo; echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"; echo "▶ $1"; echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"; }

# --- Nom de l'utilisateur : détection automatique ---
USER_NAME="${USER:-}"
if [[ -z "$USER_NAME" ]]; then
    USER_NAME="$(whoami 2>/dev/null || true)"
fi
# Les UID Android (u0_a360, u0_a123...) ne font pas un bon nom -> "user"
if [[ -z "$USER_NAME" || "$USER_NAME" == u0_a* ]]; then
    USER_NAME="user"
fi

# --- Version de la distribution (optionnelle) ---
DISTRO="${1:-ubuntu}"   # "ubuntu" = dernière LTS ; ex. "ubuntu:24.04" pour forcer

# --- Chemins recalculés à CHAQUE lancement (pas seulement à l'install) ---
# L'étape 3 est skippée en reprise : ROOTFS/CONTAINER_DIR y seraient vides (étapes 4-6 cassées).
STORAGE_DIR="${HOME}/storage/shared/openmontage"   # = /storage/emulated/0/openmontage
resolve_rootfs() {
    CONTAINER_DIR="$(ls -dt "$PREFIX"/var/lib/proot-distro/containers/*/ 2>/dev/null | head -n1)"
    ROOTFS="${CONTAINER_DIR}rootfs"
}
resolve_rootfs

# Test environnement Termux (problème TERMUX)
if [ -z "${TERMUX_VERSION:-}" ]; then
    echo
    echo "⛔ Environnement Termux non détecté (TERMUX_VERSION absent)." >&2
    echo "   Ce script doit être lancé dans Termux sur Android." >&2
    exit 1
fi

# --- Test connectivité réseau (problèmes 27-29) ---
check_network() {
    if ping -c 2 google.com >/dev/null 2>&1; then
        return 0
    fi
    # Alternative : tester via DNS
    if getent hosts github.com >/dev/null 2>&1; then
        return 0
    fi
    echo "⚠️  Aucune connectivité réseau détectée." >&2
    echo "   Vérifie ton WiFi, puis réessaie." >&2
    echo "   Solutions :" >&2
    echo "   1. Active le WiFi dans les paramètres du téléphone" >&2
    echo "   2. Vérifie le DNS : cat /etc/resolv.conf" >&2
    echo "   3. Essai manuel : echo 'nameserver 8.8.8.8' > /etc/resolv.conf" >&2
    return 1
}

step "1/6 — Mise à jour Termux (pkg update puis pkg upgrade)"
# Toujours mettre à jour (pkg existe toujours sur Termux — le tester ne sert à rien).
# Vérif réseau AVANT toute opération (problèmes 27-29).
check_network || {
    echo "❌ Pas de réseau. Arrêt." >&2
    exit 1
}
pkg update -y
pkg upgrade -y
# coreutils (sleep/yes/...) absent du bootstrap minimal — requis dès l'étape 2 (sleep 2)
pkg install -y coreutils
STEP1="done"
if [ -d "${HOME}/storage/shared/openmontage" ]; then
    STEP2="done"
else
step "2/6 — Accès stockage + dossier openmontage"
termux-setup-storage
sleep 2
mkdir -p "${STORAGE_DIR}/previews" "${STORAGE_DIR}/final" "${STORAGE_DIR}/storyboard"
ls -la "${STORAGE_DIR}"

fi
if command -v proot-distro >/dev/null 2>&1; then
    STEP3="done"
else
step "3/6 — proot-distro + installation de '${DISTRO}'"
pkg install -y proot-distro
proot-distro install "${DISTRO}"
echo "==> Version installée dans le conteneur :"
proot-distro login "${DISTRO}" -- sh -c "grep VERSION= /etc/os-release; grep VERSION_CODENAME /etc/os-release; command -v apt-get >/dev/null || echo 'FAIL: apt-get introuvable'"

resolve_rootfs   # recalcule CONTAINER_DIR/ROOTFS après install
if [[ ! -d "${ROOTFS}" ]]; then
    echo "ERREUR: rootfs du conteneur introuvable (${ROOTFS})." >&2
    exit 1
fi
echo "Rootfs du conteneur : ${ROOTFS}"

fi
# Vérifier DANS le conteneur : `id` côté Termux ne voit pas les users du conteneur
if proot-distro login "${DISTRO}" -- id "${USER_NAME}" >/dev/null 2>&1; then
    STEP4="done"
else
step "4/6 — Utilisateur '${USER_NAME}' avec sudo (NOPASSWD)"
# Heredoc NON quoté : ${USER_NAME} est expansé côté Termux lors de l'écriture du fichier
cat > "${ROOTFS}/tmp/setup_user.sh" <<USERSCRIPT
set -e
if id "${USER_NAME}" >/dev/null 2>&1; then
    echo 'Utilisateur déjà présent, on conserve.'
else
    useradd -m -s /bin/bash "${USER_NAME}"
    echo "${USER_NAME}:password" | chpasswd
fi
apt-get update -qq
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq sudo >/dev/null
if getent group sudo >/dev/null; then usermod -aG sudo "${USER_NAME}"; else groupadd sudo && usermod -aG sudo "${USER_NAME}"; fi
echo "${USER_NAME} ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/${USER_NAME}
chmod 440 /etc/sudoers.d/${USER_NAME}
[ -f /etc/sudoers.d/${USER_NAME} ] && printf '\n' >> /etc/sudoers.d/${USER_NAME}
echo 'OK — sudo NOPASSWD + password défini'
USERSCRIPT
# Login ROOT : l'utilisateur n'existe pas encore, `--user` échouerait ("no user defined")
proot-distro login "${DISTRO}" -- bash /tmp/setup_user.sh
fi

if [ -d "${HOME}/openmontage" ] && [ -f "${HOME}/openmontage/.git/HEAD" ]; then
    STEP5="done"
else
step "5/6 — Installation opencode + OpenMontage dans le PRoot (setup_ubuntu.sh adapté)"
cat > "${ROOTFS}/tmp/setup_ubuntu_pr.sh" <<'PR_UBUNTU_SCRIPT'
#!/usr/bin/env bash
#
# ============================================================================
#  OpenMontage — bootstrap d'un PRoot Ubuntu neuf (via setup_termux)
# ============================================================================
#  Adaptation de setup_ubuntu.sh (repo openmontage_base) pour tourner DANS
#  le conteneur PRoot Ubuntu créé par setup_termux, en tant que l'utilisateur
#  sudo créé en cours d'exécution.
#
#  Reconstruit, de zéro, l'environnement de travail : dépendances système,
#  opencode, le repo OpenMontage (git init + fetch SSH + venv + make
#  setup/install-dev), et la liaison GitHub par clé SSH (2 Deploy keys).
#  Modèle deux repos : le projet/setup vit sur 'openmontage_setup' (main) et les
#  reproduction scripts sont poussés sur 'openmontage_story'.
#
#  PAS DE CLONE INITIAL REQUIS : la phase 5/8 affiche les clés à ajouter.
#
#  Variables d'environnement (optionnel) :
#    OPENMONTAGE_DIR=/path/to/openmontage           # dossier du repo (défaut ~/openmontage)
#    NODE_MAJOR=22                                  # version Node installée via nvm
#    BOOTSTRAP_BRANCH=setup_<user>_story            # branche de setup (défaut: setup_<user>_story)
#    ASSUME_YES=1                                   # répond Oui aux invites
# ============================================================================

set -euo pipefail

GITHUB_REPO="yakuzas2345/openmontage_setup.git"
GITHUB_STORY_REPO="yakuzas2345/openmontage_story.git"
GITHUB_HOST_ALIAS="openmontage_setup"          # identité "repo" : fetch + push du setup vers main (openmontage_setup)
GITHUB_MAIN_ALIAS="openmontage_story"          # identité "story" : push des reproduction scripts (openmontage_story)
SSH_KEY="${HOME}/.ssh/id_ed25519_openmontage_setup"   # clé repo : openmontage_setup (projet / setup)
SSH_KEY_MAIN="${HOME}/.ssh/id_ed25519_openmontage_story" # clé story : openmontage_story (reproduction scripts)
OPENMONTAGE_DIR="${OPENMONTAGE_DIR:-${HOME}/openmontage}"
NODE_MAJOR="${NODE_MAJOR:-22}"
SRC_ENV="${1:-}"
# Branche locale créée par le setup (jamais 'main') — format: setup_<username>_story
# Jamais de tiret dans les noms de branche (règle AGENTS.md)
BOOTSTRAP_BRANCH="${BOOTSTRAP_BRANCH:-setup_$(whoami 2>/dev/null || echo user)_story}"

section() { echo; echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"; echo "▶ $1"; echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"; }
log()     { echo "  · $1"; }

# Demande une confirmation (O/n). Retour 0 si oui, 1 si non.
# ASSUME_YES=1 (ou true/yes) répond toujours Oui.
confirm() {
  local msg="$1"
  case "${ASSUME_YES:-0}" in
    1|true|yes|oui) echo "  · $msg → oui (ASSUME_YES)"; return 0 ;;
  esac
  while true; do
    read -r -p "  ${msg} [O/n] " ans
    case "${ans:-O}" in
      O|o|oui|Oui|y|Y|yes|Yes) return 0 ;;
      n|N|non|Non|no|No)        return 1 ;;
      *) echo "  Réponds O (oui) ou n (non)." ;;
    esac
  done
}

require_root_or_sudo() {
  if [ "$(id -u)" -eq 0 ]; then
    sudo() { "$@"; }
  elif ! command -v sudo >/dev/null 2>&1; then
    echo "ERREUR: sudo est requis (ou exécutez en root)." >&2; exit 1
  fi
}

# ────────────────────────────────────────────────────────────────────────
#  Test de connectivité réseau (problèmes 27-29)
# ────────────────────────────────────────────────────────────────────────
check_network() {
  if ping -c 2 google.com >/dev/null 2>&1; then
    return 0
  fi
  if getent hosts github.com >/dev/null 2>&1; then
    return 0
  fi
  echo "ERREUR: pas de connexion internet dans le conteneur." >&2
  echo "  Vérifie le WiFi sur le téléphone." >&2
  echo "  Essai DNS manuel:" >&2
  echo "    echo 'nameserver 8.8.8.8' | sudo tee /etc/resolv.conf" >&2
  exit 1
}

# ────────────────────────────────────────────────────────────────────────
#  Vérification des dépendances système (apt) — ne télécharge rien.
#  Remplit APT_NEEDED avec les paquets manquants.
# ────────────────────────────────────────────────────────────────────────
measure_apt_deps() {
  declare -A pkgs=()
  want() { pkgs["$2"]=1; }
  command -v git     >/dev/null 2>&1 || want git git
  command -v curl    >/dev/null 2>&1 || want curl curl
  command -v make    >/dev/null 2>&1 || want make build-essential
  command -v gcc     >/dev/null 2>&1 || want gcc build-essential
  command -v ffmpeg  >/dev/null 2>&1 || want ffmpeg ffmpeg
  command -v ffprobe >/dev/null 2>&1 || want ffprobe ffmpeg
  command -v python3 >/dev/null 2>&1 || want python3 python3
  command -v pip3    >/dev/null 2>&1 || want pip3 python3-pip
  # `import venv` passe même sans ensurepip (python3 -m venv échoue alors) — tester les deux
  if ! python3 -c "import venv, ensurepip" >/dev/null 2>&1; then want venv python3-venv; fi
  APT_NEEDED="${!pkgs[*]}"
}

# ────────────────────────────────────────────────────────────────────────
#  Vérification générale : liste les binaires manquants (code 1 si absent).
# ────────────────────────────────────────────────────────────────────────
report_runtime_gaps() {
  local b
  GAPS=""
  for b in git curl make gcc ffmpeg ffprobe python3 pip3 node npm npx opencode; do
    command -v "$b" >/dev/null 2>&1 || GAPS="${GAPS} $b"
  done
  if [ -z "${GAPS}" ]; then return 0; else return 1; fi
}

# ────────────────────────────────────────────────────────────────────────
section "1/8 — Détection OS"
if [ -f /etc/os-release ]; then
  # shellcheck disable=SC1091
  . /etc/os-release
  log "Distribution: ${ID} ${VERSION_ID} (${PRETTY_NAME})"
else
  echo
  echo "⛔ Impossible d'identifier la distribution : /etc/os-release introuvable." >&2
  echo "   Ce script ne fonctionne que sur Ubuntu ou Debian. Arrêt." >&2
  exit 1
fi
if [ "${ID}" != "ubuntu" ] && [ "${ID}" != "debian" ]; then
  echo
  echo "⛔ Distribution non supportée : '${ID}' (${PRETTY_NAME})." >&2
  echo "   Ce script ne fonctionne que sur Ubuntu ou Debian." >&2
  echo "   Arrêt avant toute modification du système." >&2
  exit 1
fi
if [ "$(id -u)" -ne 0 ] && ! command -v sudo >/dev/null 2>&1; then
  echo
  echo "⛔ Ubuntu détecté, mais 'sudo' est manquant." >&2
  echo "   Installe-le puis relance le script, par exemple :" >&2
  echo "     su -c 'apt-get update && apt-get install -y sudo'" >&2
  echo "   (ou lance directement le script en root). Arrêt." >&2
  exit 1
fi
require_root_or_sudo

# ────────────────────────────────────────────────────────────────────────
section "2/8 — Vérification & installation des dépendances système"
# Test réseau avant apt (problèmes 27-29)
check_network
measure_apt_deps
if [ -z "${APT_NEEDED}" ]; then
  log "Toutes les dépendances système sont déjà présentes — rien à installer."
else
  echo "  Paquets apt manquants :${APT_NEEDED}"
  if confirm "Installer ces paquets via apt (sudo, téléchargement requérant réseau) ?"; then
    sudo apt-get update -y
    sudo apt-get install -y ${APT_NEEDED}
    measure_apt_deps
    if [ -n "${APT_NEEDED}" ]; then
      echo "ERREUR: certains paquets n'ont pas pu être installés :${APT_NEEDED}" >&2
      echo "  Corrige et relance le script." >&2
      exit 1
    fi
    log "Paquets installés."
  else
    echo "  ❌ Installe-les manuellement, puis relance le script."
    echo "  Requis :${APT_NEEDED}"
    exit 1
  fi
fi
log "Versions: git $(git --version | awk '{print $3}'), ffmpeg $(ffmpeg -version | head -n1 | awk '{print $3}')"

# ────────────────────────────────────────────────────────────────────────
section "3/8 — Node.js ≥ ${NODE_MAJOR} (via nvm, fallback apt)"
if command -v node >/dev/null 2>&1 && [ "$(node -v | sed 's/^v//' | cut -d. -f1)" -ge "${NODE_MAJOR}" ]; then
  log "Node déjà présent: $(node -v) — OK."
else
  if confirm "Node/nvm absents — télécharger et installer Node ${NODE_MAJOR} via nvm ?"; then
    export NVM_DIR="${HOME}/.nvm"
    if [ ! -s "${NVM_DIR}/nvm.sh" ]; then
      log "Installation de nvm..."
      curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash
    fi
    . "${NVM_DIR}/nvm.sh"
    log "Installation de Node ${NODE_MAJOR} (nvm)..."
    nvm install "${NODE_MAJOR}"
    nvm alias default "${NODE_MAJOR}" >/dev/null
  else
    echo "  ❌ Node ≥ ${NODE_MAJOR} requis — installe-le puis relance." >&2
    exit 1
  fi
fi
# Met node/npm/npx sur le PATH (nvm, shell non interactif)
export NVM_DIR="${HOME}/.nvm"
if [ -s "${NVM_DIR}/nvm.sh" ]; then . "${NVM_DIR}/nvm.sh"; fi

# AJOUT: chemin corepack npm (problème 8 — npm via corepack dans /usr/share/nodejs/corepack/shims/)
if [ -d /usr/share/nodejs/corepack/shims ]; then
  export PATH="/usr/share/nodejs/corepack/shims:${PATH}"
  log "PATH enrichi avec corepack shims: /usr/share/nodejs/corepack/shims"
fi

# Fallback apt si nvm a échoué (problème 7)
if ! command -v node >/dev/null 2>&1; then
  log "nvm a échoué, tentative via nodesource apt..."
  check_network
  curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | sudo bash -
  sudo apt-get install -y nodejs
fi

if command -v node >/dev/null 2>&1; then
  log "Node disponible: $(node -v), npm $(npm -v)."
else
  echo "ERREUR: node introuvable après installation nvm + fallback apt." >&2; exit 1
fi

# ────────────────────────────────────────────────────────────────────────
section "4/8 — opencode"
if [ -x "${HOME}/.opencode/bin/opencode" ]; then
  log "opencode déjà installé: $("${HOME}/.opencode/bin/opencode" --version) — OK."
elif command -v opencode >/dev/null 2>&1; then
  # Problème 10/11: opencode installé globalement mais pas dans ~/.opencode/bin/
  log "opencode trouvé dans PATH (install global): $(opencode --version)"
  log "Création du symlink ~/.opencode/bin/opencode → $(command -v opencode)..."
  mkdir -p "${HOME}/.opencode/bin"
  ln -sf "$(command -v opencode)" "${HOME}/.opencode/bin/opencode"
  log "Symlink créé: ${HOME}/.opencode/bin/opencode"
else
  if confirm "opencode absent — télécharger et installer (script officiel opencode.ai) ?"; then
    log "Installation via le script officiel (https://opencode.ai/install)..."
    curl -fsSL https://opencode.ai/install | bash
  else
    echo "  ❌ opencode requis — installe-le puis relance." >&2
    exit 1
  fi
fi
export PATH="${HOME}/.opencode/bin:${PATH}"
opencode --version
# `bash -c` (alias openmontage, scripts non-interactifs) ne lit pas ~/.bashrc :
# exposer opencode sur le PATH par défaut via /usr/local/bin, quel que soit l'invocateur
if [ -x "${HOME}/.opencode/bin/opencode" ]; then
  sudo ln -sf "${HOME}/.opencode/bin/opencode" /usr/local/bin/opencode
  log "Symlink /usr/local/bin/opencode → ${HOME}/.opencode/bin/opencode"
fi

# Configuration opencode (provider Agnes, identique à la machine source)
OPTCFG="${HOME}/.config/opencode/opencode.jsonc"
if [ ! -f "${OPTCFG}" ]; then
  mkdir -p "${HOME}/.config/opencode"
  cat > "${OPTCFG}" <<'JSON'
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "agnes": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Agnes AI",
      "options": {
        "baseURL": "https://apihub.agnes-ai.com/v1",
        "apiKey": "{env:AGNES_API_KEY}"
      },
      "models": {
        "agnes-2.5-flash": {
          "name": "Agnes 2.5 Flash",
          "tool_call": true,
          "temperature": true,
          "limit": { "context": 512000, "output": 65536 }
        },
        "agnes-2.0-flash": {
          "name": "Agnes 2.0 Flash",
          "tool_call": true,
          "temperature": true
        },
        "agnes-1.5-flash": {
          "name": "Agnes 1.5 Flash",
          "tool_call": true
        }
      }
    }
  }
}
JSON
  log "Config opencode écrite: ${OPTCFG}"
else
  log "Config opencode déjà présente: ${OPTCFG} — inchangée."
fi

# ────────────────────────────────────────────────────────────────────────
#  Le repo est PRIVÉ : il faut la clé SSH AVANT de pouvoir le charger.
# ────────────────────────────────────────────────────────────────────────
section "5/8 — Liaison GitHub (deux Deploy keys : setup + story)"
mkdir -p "${HOME}/.ssh"
chmod 700 "${HOME}/.ssh"

# Clé A — identité 'story' : pousse les reproduction scripts vers openmontage_story
if [ ! -f "${SSH_KEY_MAIN}" ]; then
  if confirm "Générer la clé 'story' (${SSH_KEY_MAIN}) pour pousser les reproduction scripts vers openmontage_story ?"; then
    ssh-keygen -t ed25519 -C "openmontage_story" -f "${SSH_KEY_MAIN}" -N "" -q
    log "Clé 'story' générée: ${SSH_KEY_MAIN}"
  else
    echo "  ❌ La clé 'story' est nécessaire pour pousser les reproduction scripts sur openmontage_story." >&2
    exit 1
  fi
else
  log "Clé 'story' déjà présente: ${SSH_KEY_MAIN}"
fi

# Clé B — identité 'setup' : fetch du projet + push du setup vers main
if [ ! -f "${SSH_KEY}" ]; then
  if confirm "Générer la clé 'setup' (${SSH_KEY}) pour l'accès au projet et le push du setup vers main ?"; then
    ssh-keygen -t ed25519 -C "openmontage_setup" -f "${SSH_KEY}" -N "" -q
    log "Clé 'setup' générée: ${SSH_KEY}"
  else
    echo "  ❌ La clé 'setup' est nécessaire pour accéder au repo privé." >&2
    exit 1
  fi
else
  log "Clé 'setup' déjà présente: ${SSH_KEY}"
fi

# Alias SSH dans ~/.ssh/config (idempotents)
CFG="${HOME}/.ssh/config"
ensure_alias() { # ensure_alias <alias> <clé>
  if [ ! -f "${CFG}" ] || ! grep -qE "^Host[[:space:]]+${1}([[:space:]]|$)" "${CFG}"; then
    cat >> "${CFG}" <<CFG

Host ${1}
    HostName github.com
    User git
    IdentityFile ${2}
    IdentitiesOnly yes
CFG
    log "Alias SSH '${1}' ajouté au config."
  else
    log "Alias SSH '${1}' déjà présent — inchangé."
  fi
}
ensure_alias "${GITHUB_MAIN_ALIAS}" "${SSH_KEY_MAIN}"
ensure_alias "${GITHUB_HOST_ALIAS}" "${SSH_KEY}"
chmod 600 "${CFG}" 2>/dev/null || true

_display_keys() {
  echo ""
  echo "┌──────────────────────────────────────────────────────────────┐"
  echo "│  AJOUTE CES DEUX CLÉS PUBLIQUES SUR GITHUB                   │"
  echo "│  · '${GITHUB_HOST_ALIAS}' → yakuzas2345/openmontage_setup  (write) │"
  echo "│  · '${GITHUB_MAIN_ALIAS}' → yakuzas2345/openmontage_story  (write) │"
  echo "└──────────────────────────────────────────────────────────────┘"
  echo ""
  echo "  ➤ CLÉ '${GITHUB_HOST_ALIAS}' (fetch + push du setup vers main)"
  echo "     → repo yakuzas2345/openmontage_setup — Settings → Deploy keys"
  cat "${SSH_KEY}.pub"
  echo ""
  echo "  ➤ CLÉ '${GITHUB_MAIN_ALIAS}' (push des reproduction scripts)"
  echo "     → repo yakuzas2345/openmontage_story — Settings → Deploy keys"
  cat "${SSH_KEY_MAIN}.pub"
  echo ""
}

