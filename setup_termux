  # Problème 15/17: branch naming avec _ et gestion conflit
  STORY_REMOTE="origin_${BOOTSTRAP_BRANCH}"
  git remote add "${STORY_REMOTE}" "git@${GITHUB_MAIN_ALIAS}:${GITHUB_STORY_REPO}"
  log "Récupération de l'historique depuis git@${GITHUB_HOST_ALIAS}:${GITHUB_REPO} ..."
  git fetch origin_main
  git fetch "${STORY_REMOTE}"
  log "Remotes prêts : 'origin_main' (projet/setup → main) + '${STORY_REMOTE}' (reproduction scripts → ${BOOTSTRAP_BRANCH})."

  # Si ce script a été téléchargé DANS le futur dossier du repo, il bloquerait
  # le checkout (fichier non suivi en conflit avec la version distante).
  # On le déplace temporairement : le fd d'exécution reste ouvert, donc le
  # script continue de tourner, et la version distante le réécrit proprement.
  SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  if [ "${SELF}" = "${OPENMONTAGE_DIR}/scripts/setup_ubuntu.sh" ]; then
    mkdir -p "${OPENMONTAGE_DIR}/.bootstrap/"
    mv "${SELF}" "${OPENMONTAGE_DIR}/.bootstrap/setup_ubuntu.sh.running"
    log "Script déplacé en .bootstrap/ pour libérer le checkout ..."
  fi

  # Problème 15: branch naming — toujours utiliser _ (jamais -)
  # Vérifier si la branche existe déjà sur le remote et ajouter suffixe numeric
  _ensure_bootstrap_branch() {
    local branch="$1"
    # Vérifier si la branche existe localement
    if git branch --list "${branch}" | grep -q "${branch}"; then
      log "Branche locale '${branch}' existe déjà."
      return 0
    fi
    # Vérifier si la branche existe sur le remote
    if git ls-remote --heads "${STORY_REMOTE}" "${branch}" 2>/dev/null | grep -q "${branch}"; then
      log "Branche远程 '${branch}' existe — création locale."
      git checkout -b "${branch}" "${STORY_REMOTE}/${branch}" 2>/dev/null && return 0
    fi
    # Créer la branche à partir de origin_main/main
    git checkout -b "${branch}" origin_main/main 2>&1
  }

  # Nouvelle branche locale (JAMAIS 'main') issue de origin_main/main
  # Gérer les conflits de noms de branche (problème 15)
  if ! git checkout -b "${BOOTSTRAP_BRANCH}" origin_main/main 2>&1; then
    log "Branche '${BOOTSTRAP_BRANCH}' déjà présente — checkout direct."
    if ! git checkout "${BOOTSTRAP_BRANCH}" 2>&1; then
      # Essayer avec suffixe numeric (problème 15)
      local_suffix=2
      while [ "${local_suffix}" -lt 100 ]; do
        alt_branch="${BOOTSTRAP_BRANCH}_${local_suffix}"
        if git checkout -b "${alt_branch}" origin_main/main 2>/dev/null; then
          log "Conflit résolu — création de la branche '${alt_branch}' (suffixe ${local_suffix})."
          BOOTSTRAP_BRANCH="${alt_branch}"
          STORY_REMOTE="origin_${BOOTSTRAP_BRANCH}"
          # Mettre à jour le remote story
          git remote set-url "${STORY_REMOTE}" "git@${GITHUB_MAIN_ALIAS}:${GITHUB_STORY_REPO}" 2>/dev/null || \
            git remote add "${STORY_REMOTE}" "git@${GITHUB_MAIN_ALIAS}:${GITHUB_STORY_REPO}"
          break
        fi
        local_suffix=$((local_suffix + 1))
      done
      if [ "${local_suffix}" -ge 100 ]; then
        echo "ERREUR: impossible de créer la branche bootstrap après 100 tentatives." >&2
        exit 1
      fi
    fi
  fi

  rm -f "${OPENMONTAGE_DIR}/.bootstrap/setup_ubuntu.sh.running"
  log "Branche locale '${BOOTSTRAP_BRANCH}' (issue de origin_main/main): $(git log --oneline -1)"
fi

# Normalisation branches/remotes (AGENTS.md) : exactement 2 branches locales
# (`main` → openmontage_setup/main, `setup_<user>_story` → openmontage_story),
# aucun tiret nulle part. Converge à chaque run (nettoie les résidus).
_normalize_branches() {
  local b r
  for b in $(git for-each-ref --format='%(refname:short)' refs/heads/); do
    case "${b}" in
      *-* ) git branch -D "${b}" 2>/dev/null && log "Branche résiduelle '${b}' supprimée (tiret interdit)." || true ;;
    esac
  done
  for r in $(git remote); do
    case "${r}" in
      *-* ) git remote remove "${r}" 2>/dev/null && log "Remote résiduel '${r}' supprimé (tiret interdit)." || true ;;
    esac
  done
  git branch --track main origin_main/main 2>/dev/null || true
  git checkout -q "${BOOTSTRAP_BRANCH}" 2>/dev/null || git checkout -qb "${BOOTSTRAP_BRANCH}" origin_main/main
  git branch --set-upstream-to="origin_${BOOTSTRAP_BRANCH}/${BOOTSTRAP_BRANCH}" 2>/dev/null \
    || log "Upstream setup '${BOOTSTRAP_BRANCH}' pas encore créé — premier push le créera."
  log "Branches locales : $(git for-each-ref --format='%(refname:short)' refs/heads/ | tr '\n' ' ')"
}
